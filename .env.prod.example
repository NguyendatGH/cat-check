# Production settings for docker-compose.prod.yml. NAMES only, no real values.
# On the server: cp .env.prod.example .env, fill in every empty value, chmod 600 .env.
# Never reuse local/staging secrets here. Guide: docs/DEPLOYMENT.md.

# Makes plain `docker compose ...` use the prod file in this directory.
COMPOSE_FILE=docker-compose.prod.yml

# Public host name. Its DNS A/AAAA record must point at this server; Caddy gets the TLS
# certificate for it automatically. HTTPS is required: the session cookie is __Host- (Secure).
DOMAIN=

# ==== Database ====
DB_NAME=catcheck
DB_USER=catcheck
# Generate: openssl rand -base64 32
DB_PASSWORD=

# ==== Mail (real SMTP; the sender address is MAIL_USERNAME) ====
# Optional if SMTP_EMAIL / SMTP_APP_PASSWORD (the local names) are already set: MAIL_* wins, SMTP_* is the
# fallback, host/port default to smtp.gmail.com:587.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ==== Google OAuth2 ====
# Authorized redirect URI in Google Cloud Console: https://<DOMAIN>/login/oauth2/code/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ==== Secrets outside the DB (app refuses to start without them) ====
# Format v<version>:<base64 of 32 bytes>. Generate: echo "v1:$(openssl rand -base64 32)"
APP_PII_ENCRYPTION_KEYS=
# Each >= 32 bytes and all different. Generate each: openssl rand -base64 48
ACTIVATION_PEPPER=
RECOVERY_CODE_PEPPER=
OTP_PEPPER=
# Signs /api/v1/media URLs when images are stored on the server volume (no Cloudinary).
# Generate: openssl rand -base64 48
CATCHECK_STORAGE_LOCAL_URLSIGNINGKEY=

# ==== Optional: uncomment only what you use (an empty value is not the same as unset) ====
# Image storage on Cloudinary instead of the server volume:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# AI assistant LLM (off by default; answers fall back to quoting care tips):
# CATCHECK_AI_ENABLED=true
# CATCHECK_AI_API_KEY=
# CATCHECK_AI_CHAT_MODEL=
# Push notifications: put firebase-service-account.json next to docker-compose.prod.yml
# (sudo chown 1001:1001 + chmod 600); compose mounts it and sets FIREBASE_SERVICE_ACCOUNT_PATH itself.
# The project id is read from the JSON; set this only to override it:
# FIREBASE_PROJECT_ID=
# PayOS online payment for shop orders (payos.vn: my.payos.vn -> payment channel -> keys).
# Set all three or none: without them the PayOS option is hidden and buyers see only cash on delivery (COD).
# Guide: docs/DEPLOYMENT.md "PayOS".
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
