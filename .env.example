# .env.example — TÊN biến cấu hình cho CatCheck (KHÔNG chứa giá trị thật).
# Copy thành `.env` (đã gitignore) và điền giá trị thật cho môi trường của bạn.
#
# Spring Boot validate config fail-fast lúc khởi động (p18) — thiếu biến bắt
# buộc ở `prod` sẽ khiến app không start, thay vì start "hư" với giá trị rỗng.
#
# Xem spec/parts/p18-devops.md + spec/reference/research-integrations.md §15.

# ==== Domain / môi trường ====

# Tên miền cho Caddy reverse proxy (Y2 chưa chốt). Local/dev: để trống, dùng
# default "catcheck.local" trong Caddyfile. Prod: điền domain thật khi có VPS.
DOMAIN=

# Spring profile đang chạy: local | staging | prod. BẮT BUỘC ở prod/staging,
# default an toàn ở local là `local`.
SPRING_PROFILES_ACTIVE=local

# ==== Database (PostgreSQL 18.6) ====

# Host Postgres. Local (native): localhost. Trong docker-compose --profile full: postgres.
DB_HOST=localhost
# Cổng Postgres bên trong network (KHÔNG phải cổng publish ra host, xem cuối file).
DB_PORT=5432
DB_NAME=catcheck
DB_USER=catcheck
# BẮT BUỘC ở prod/staging (không có default an toàn ngoài local). Local dùng
# giá trị mẫu "catcheck_local_only" đã hard-code sẵn trong docker-compose.yml.
DB_PASSWORD=

# ==== Mail (Mailpit ở dev, SMTP thật ở prod) ====

# Local (native): localhost. Trong docker-compose --profile full: mailpit.
MAIL_HOST=localhost
MAIL_PORT=1025

# ==== Google OAuth2 (đăng nhập) ====

# BẮT BUỘC ở prod/staging để OAuth2 login hoạt động; local có thể để trống
# nếu chỉ test luồng không cần Google login.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ==== Firebase Cloud Messaging (push notification) ====

# CHỈ đường dẫn file service-account JSON — KHÔNG nhét nội dung JSON trực tiếp
# vào biến env. Mount file qua Docker secret hoặc bind volume read-only, vd.
# /run/secrets/firebase-service-account.json — file này KHÔNG được commit
# (đã gitignore: firebase-adminsdk*.json).
FIREBASE_SERVICE_ACCOUNT_PATH=
# VAPID key cho web push (FE dùng để subscribe). BẮT BUỘC ở prod/staging để
# push hoạt động; local có thể để trống nếu không test push.
FCM_VAPID_KEY=

# ==== Bảo mật dữ liệu ====

# Danh sách khoá mã hoá PII (xoay khoá được — nhiều khoá phân tách bằng dấu
# phẩy, khoá đầu tiên dùng để encrypt mới, các khoá còn lại chỉ để decrypt dữ
# liệu cũ). Định dạng bắt buộc "v<version>:<base64 32 byte>", ví dụ
# "v1:CloKO4ynWhcsVst049R7CP4bTplnynDtCGsSiFIOUgU=" (sinh bằng
# `python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)))"`).
# BẮT BUỘC ở mọi môi trường có dữ liệu thật (prod/staging); local cần đặt giá
# trị bất kỳ (đủ độ dài) để app start được, KHÔNG dùng chung khoá giữa các
# môi trường.
APP_PII_ENCRYPTION_KEYS=

# Ba pepper HMAC dưới đây BẮT BUỘC ở MỌI môi trường kể cả local — thiếu là app
# KHÔNG khởi động được (fail-fast, xác nhận thật: ném IllegalStateException lúc
# tạo bean). Đây là bí mật NGOÀI DB (p11 §11.2.1, §11.7.4, §11.12.3) nên KHÔNG
# có default an toàn. Mỗi giá trị cần >= 32 byte UTF-8, KHÔNG dùng chung pepper
# giữa ba biến hay giữa các môi trường.
ACTIVATION_PEPPER=
RECOVERY_CODE_PEPPER=
OTP_PEPPER=

# ==== Công cụ dev (không phải config app) ====

# Personal access token của Figma — dùng khi cần đọc file thiết kế qua API.
# Đã di dời từ figma-key.txt (từng nằm plain text ở gốc repo, xem SECURITY-NOTE.md).
FIGMA_TOKEN=

# ==== CI/CD ====

# Đăng nhập Docker Hub trong GitHub Actions (tránh rate-limit anonymous pull
# 100 pull/6h/IP — xem .github/workflows/*.yml, docker/login-action ở đầu mọi
# job có docker pull/build). Đặt trong GitHub Secrets, KHÔNG đặt trong .env
# local — liệt kê ở đây để biết tên biến CI cần.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# =====================================================================
# ---- Biến port mapping cho docker-compose.staging.yml (KHÔNG phải config
# app, chỉ dùng khi deploy staging/prod trên VPS để 2 project Compose không
# tranh cổng nhau trên cùng máy — xem comment trong docker-compose.staging.yml).
# Có default an toàn sẵn trong file compose, chỉ cần set nếu muốn đổi cổng.
# ====================================================================
# DB_HOST_PORT=
# MAILPIT_UI_HOST_PORT=
# MAILPIT_SMTP_HOST_PORT=
# BACKEND_HTTP_HOST_PORT=
# BACKEND_MGMT_HOST_PORT=
# FRONTEND_HOST_PORT=
# CADDY_HTTP_PORT=
# CADDY_HTTPS_PORT=

# ==== Lưu trữ ảnh (Cloudinary) ====
# Ảnh (avatar, ảnh quét) upload lên Cloudinary type=authenticated (không công khai).
# Thiếu 3 biến dưới đây => backend tự dùng thư mục local (CATCHECK_STORAGE_PROVIDER=auto).
# Ép chế độ: CATCHECK_STORAGE_PROVIDER=local|cloudinary|auto. Thư mục gốc: CLOUDINARY_FOLDER (mặc định catcheck).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
